<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>InkPadResetter</AssemblyName>
    <RootNamespace>InkPadResetter.App</RootNamespace>
    <Product>Ink Pad Resetter</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InkPadResetter.Core\InkPadResetter.Core.csproj" />
  </ItemGroup>

</Project>
