<Window x:Class="InkPadResetter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ink Pad Resetter"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ground}"
        FontFamily="{StaticResource Sans}"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True">
    <Grid x:Name="Root" Width="760" MinHeight="484" Background="{StaticResource Ground}">
        <Grid Margin="36,28,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Printer -->
            <DockPanel Grid.Row="0">
                <Button x:Name="ReadAgainButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Content="Read again" Click="ReadAgain_Click" />
                <Viewbox Width="28" Height="28" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="{StaticResource Text2}" StrokeThickness="1.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M6,9 V3 H18 V9 M4.5,9 H19.5 A1.5,1.5 0 0 1 21,10.5 V15.5 A1.5,1.5 0 0 1 19.5,17 H4.5 A1.5,1.5 0 0 1 3,15.5 V10.5 A1.5,1.5 0 0 1 4.5,9 Z M7,14 H17 V21 H7 Z" />
                    </Canvas>
                </Viewbox>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PrinterName" FontSize="15" FontWeight="Medium" Text="Epson printer" />
                    <TextBlock x:Name="PrinterDetail" Margin="0,2,0,0" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource Text2}" Text="USB" />
                </StackPanel>
            </DockPanel>

            <!-- Status -->
            <StackPanel Grid.Row="2">
                <StackPanel x:Name="EyebrowRow" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Eyebrow" Margin="10,0,0,0" FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource Amber}" Text="STATUS" />
                </StackPanel>
                <TextBlock x:Name="Heading" Margin="0,8,0,0" FontSize="32" FontWeight="SemiBold" Text="Looking for the printer…" />
                <TextBlock x:Name="Body" Margin="0,8,0,0" MaxWidth="580" HorizontalAlignment="Left" FontSize="14"
                           LineHeight="21" TextWrapping="Wrap" Foreground="{StaticResource Text2}" />
                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left" FontSize="13"
                           TextWrapping="Wrap" Foreground="{StaticResource Amber}" Visibility="Collapsed" />
            </StackPanel>

            <!-- Counters -->
            <Border x:Name="CountersPanel" Grid.Row="4" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource LineStrong}" Background="{StaticResource LineStrong}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" CornerRadius="7,0,0,7" Padding="18,16">
                        <StackPanel>
                            <TextBlock x:Name="Counter1Label" FontSize="12" Foreground="{StaticResource Text2}" />
                            <TextBlock x:Name="Counter1Value" Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="24" />
                            <TextBlock x:Name="Counter1Detail" Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="12"
                                       Foreground="{StaticResource Text3}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="1,0,0,0" Background="{StaticResource Panel}" CornerRadius="0,7,7,0" Padding="18,16">
                        <StackPanel>
                            <TextBlock x:Name="Counter2Label" FontSize="12" Foreground="{StaticResource Text2}" />
                            <TextBlock x:Name="Counter2Value" Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="24" />
                            <TextBlock x:Name="Counter2Detail" Margin="0,6,0,0" FontFamily="{StaticResource Mono}" FontSize="12"
                                       Foreground="{StaticResource Text3}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Backup -->
            <StackPanel x:Name="BackupRow" Grid.Row="6" Orientation="Horizontal" Visibility="Collapsed">
                <Path x:Name="BackupTick" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
                      Stroke="{StaticResource Text2}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Data="M20,6 L9,17 L4,12" />
                <TextBlock x:Name="BackupText" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                <TextBlock x:Name="BackupLinkBlock" Margin="8,0,0,0" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center">
                    <Hyperlink x:Name="BackupLink" Style="{StaticResource FileLink}" Click="BackupLink_Click">
                        <Run x:Name="BackupFileName" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="8" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PadBox" Margin="0,0,20,0" Padding="14,11" CornerRadius="6" BorderThickness="1"
                            Background="#1E1A14" BorderBrush="#4A3B22" VerticalAlignment="Center">
                        <CheckBox x:Name="PadCheck" Style="{StaticResource PadCheckBox}" Checked="PadCheck_Changed" Unchecked="PadCheck_Changed">
                            <TextBlock TextWrapping="Wrap" LineHeight="19"
                                       Text="I've cleaned or replaced the ink pad, or fitted an external waste tank." />
                        </CheckBox>
                    </Border>
                    <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Reset counters"
                            IsEnabled="False" VerticalAlignment="Center" Click="Reset_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
